NEXT_PUBLIC_BASE_URL="" # https://typed.sanitypress.dev

NEXT_PUBLIC_SANITY_PROJECT_ID="jy7u0ikv"
NEXT_PUBLIC_SANITY_DATASET="production"
# localhost:3333 in development; production Studio has a separate origin.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
SANITY_STUDIO_ORIGIN="http://localhost:3333"

SANITY_API_READ_TOKEN=""
SANITY_API_WRITE_TOKEN=""

# Cloudflare D1 (Edge SQL Database for Leads, Orders, Reviews, Comments)
D1_DATABASE_ID=""
D1_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Real-time Sales Alerts (Telegram / Webhooks)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
LEAD_WEBHOOK_URL=""
ORDER_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_URL=""

# Required. Generate a unique random value (at least 32 bytes); never commit it.
ADMIN_JWT_SECRET=""
# Explicit development-only simulator; never allowed in production.
D1_ALLOW_MEMORY="false"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Only trusted site administrators may enable unsandboxed editorial HTML.
ALLOW_TRUSTED_CUSTOM_HTML="false"
# Optional scheduler credential for POST /api/admin/outbox (at least 32 bytes).
OUTBOX_CRON_SECRET=""

# Opt-in Free profile: published snapshots; rebuild after CMS changes. See runbook.
NEXT_PUBLIC_DEPLOYMENT_PROFILE="free"
# Email/password in D1. See docs/ADMIN_PASSWORD_SIGN_IN.md.
NEXT_PUBLIC_ADMIN_AUTH_MODE="password"
# Empty: 0 on Free, 1 on standard. Set 0..1 to sample document-level beacons.
NEXT_PUBLIC_VITALS_SAMPLE_RATE=""
# Free always caps drains at one job; standard defaults to 15.
OUTBOX_MAX_JOBS_PER_INVOCATION=""
# Temporary diagnostics only: logs query counts/timing, never SQL or parameters.
D1_LOG_METRICS="false"
