{
	"name": "deanflow-engine",
	"version": "0.0.41",
	"private": true,
	"packageManager": "npm@10.9.8",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "next dev --webpack",
		"dev:turbopack": "next dev",
		"build": "next build --webpack",
		"build:cf": "opennextjs-cloudflare build",
		"preview:cf": "opennextjs-cloudflare preview",
		"deploy:cf": "opennextjs-cloudflare deploy",
		"start": "next start",
		"lint": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"typegen": "sanity schema extract --path=./src/sanity/extract.json --force && sanity typegen generate",
		"format": "prettier --write '**/*.{ts,tsx,js,jsx}'",
		"test": "node --test tests/*.test.cjs",
		"lint:security": "node scripts/lint-security.cjs",
		"verify:migrations": "node scripts/verify-migrations.cjs",
		"verify:release": "node scripts/release-gate.cjs",
		"verify:production": "node scripts/release-gate.cjs --env=production",
		"predeploy:cf": "npm run verify:production",
		"perf:check": "node scripts/perf-check.cjs",
		"d1:migrate:local": "wrangler d1 migrations apply DB --local",
		"d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"d1:backup": "bash scripts/d1-backup.sh",
		"d1:restore": "bash scripts/d1-restore.sh"
	},
	"dependencies": {
		"@portabletext/to-html": "^5.0.1",
		"@sanity/assist": "^6.2.6",
		"@sanity/code-input": "^7.0.2",
		"@sanity/dashboard": "^6.0.22",
		"@sanity/image-url": "^2.1.1",
		"@sanity/vision": "^6.9.2",
		"@vercel/analytics": "^1.6.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"bcryptjs": "^3.0.3",
		"clsx": "^2.1.1",
		"framer-motion": "^14.10.1",
		"lightbox.js-react": "^1.6.7",
		"lucide-react": "^0.562.0",
		"next": "^16.4.6",
		"next-sanity": "^12.0.7",
		"nuqs": "^2.8.6",
		"react": "^19.2.3",
		"react-dom": "19.3.1",
		"react-icons": "^5.5.0",
		"sanity": "^6.20.0",
		"sanity-plugin-dashboard-widget-vercel": "^4.0.32",
		"sanity-plugin-media": "^6.6.2",
		"shiki": "^3.20.0",
		"styled-components": "^6.6.0",
		"sweetalert2": "^11.26.17",
		"sweetalert2-react-content": "^5.1.1",
		"swiper": "^12.2.0",
		"tailwind-merge": "^3.4.0",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@opennextjs/cloudflare": "^1.20.16",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"wrangler": "^4.160.0"
	},
	"overrides": {
		"glob@>=9 <14.0.2": "^14.0.4",
		"minimatch@>=7 <11.0.1": "^11.0.8",
		"js-yaml@>=3 <3.15.2": "^3.15.2",
		"smol-toml@<=1.8.0": "^1.9.1",
		"postcss-selector-parser@>=6 <6.1.5": "^6.1.6"
	}
}
