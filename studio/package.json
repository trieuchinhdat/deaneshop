{
  "name": "deanflow-studio",
  "version": "0.0.41",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --path=./schema.json --force && TS_NODE_PROJECT=../tsconfig.json sanity typegen generate && node scripts/format-types.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "sanity": "6.23.0",
    "@sanity/assist": "^6.2.6",
    "@sanity/code-input": "^7.0.2",
    "@sanity/dashboard": "^6.0.22",
    "@sanity/vision": "^6.9.2",
    "sanity-plugin-dashboard-widget-vercel": "^4.0.32",
    "sanity-plugin-media": "^6.6.2",
    "styled-components": "6.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.5.0",
    "framer-motion": "14.12.0",
    "@sanity/client": "7.26.2",
    "@sanity/ui": "3.5.2",
    "@sanity/icons": "3.7.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.6"
  },
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.8",
    "js-yaml@>=3 <3.15.2": "^3.15.2",
    "smol-toml@<=1.8.0": "^1.9.1",
    "postcss-selector-parser@>=6 <6.1.5": "^6.1.6"
